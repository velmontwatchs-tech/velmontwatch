<div class="custom-announcement-bar">
  <p class="custom-announcement-bar__text">hello world!</p>
</div>

{% stylesheet %}
  .custom-announcement-bar {
    background-color: #000000;
    width: 100%;
    padding: 12px 16px;
    text-align: center;
  }

  .custom-announcement-bar__text {
    color: #ffffff;
    margin: 0;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Announcement Bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": []
}
{% endschema %}
