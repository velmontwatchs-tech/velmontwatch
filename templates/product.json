    "custom_liquid_7KcjMF": {
      "type": "custom-liquid",
      "name": "Block 1",
      "settings": {
        "custom_liquid": "<div class=\"vm-urgency\">\n  <div class=\"vm-demand\">\n    <div class=\"vm-demand__head\">\n      <span class=\"vm-demand__label\">Vraag dit seizoen</span>\n      <span class=\"vm-demand__value\">Hoog</span>\n    </div>\n    <div class=\"vm-demand__track\"><div class=\"vm-demand__fill\" style=\"--vm-level:78%;\"></div></div>\n  </div>\n\n  <div class=\"vm-stock\">\n    <span class=\"vm-stock__dot\" aria-hidden=\"true\"></span>\n    <span class=\"vm-stock__text\"><strong>Beperkte voorraad</strong> — dit model is bijna uitverkocht.</span>\n  </div>\n\n  <div class=\"vm-deal\">\n    <span class=\"vm-deal__label\"><i class=\"vm-deal__spark\" aria-hidden=\"true\"></i>Actie eindigt over</span>\n    <span class=\"vm-deal__clock\" id=\"vm-countdown\">\n      <b class=\"vm-seg\"><span data-vm=\"h\">00</span><small>uur</small></b>\n      <i class=\"vm-colon\">:</i>\n      <b class=\"vm-seg\"><span data-vm=\"m\">15</span><small>min</small></b>\n      <i class=\"vm-colon\">:</i>\n      <b class=\"vm-seg\"><span data-vm=\"s\">00</span><small>sec</small></b>\n    </span>\n  </div>\n</div>\n\n<style>\n.vm-urgency{ width:100%; box-sizing:border-box; font-family:inherit; }\n\n.vm-demand__head{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:8px; }\n.vm-demand__label{ font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--vm-muted,#6E7178); font-weight:500; }\n.vm-demand__value{ font-size:11px; letter-spacing:.14em; text-transform:uppercase; font-weight:700; color:var(--vm-accent,#B4342A); }\n.vm-demand__track{ height:4px; border-radius:99px; background:var(--vm-line,#E6E7EA); overflow:hidden; }\n.vm-demand__fill{\n  height:100%; width:0; border-radius:99px; position:relative; overflow:hidden;\n  background:linear-gradient(90deg,var(--vm-gold,#C2A268) 0%,#D2703E 55%,var(--vm-accent,#B4342A) 100%);\n  animation:vmFill 1.4s cubic-bezier(.22,.8,.25,1) forwards;\n}\n.vm-demand__fill::after{\n  content:\"\"; position:absolute; inset:0; transform:translateX(-100%);\n  background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);\n  animation:vmShine 2.8s ease-in-out 1.4s infinite;\n}\n@keyframes vmFill{ to{ width:var(--vm-level); } }\n@keyframes vmShine{ 0%{transform:translateX(-100%)} 60%,100%{transform:translateX(200%)} }\n\n.vm-stock{\n  display:flex; align-items:center; gap:10px; margin-top:14px; padding:11px 14px;\n  background:#FCF6F5; border:1px solid #F0DCD9; border-left:2px solid var(--vm-accent,#B4342A); border-radius:3px;\n}\n.vm-stock__dot{ flex:0 0 auto; width:7px; height:7px; border-radius:50%; background:var(--vm-accent,#B4342A); position:relative; }\n.vm-stock__dot::before{\n  content:\"\"; position:absolute; inset:-4px; border-radius:50%;\n  border:1px solid var(--vm-accent,#B4342A); animation:vmPulse 1.9s ease-out infinite;\n}\n@keyframes vmPulse{ 0%{transform:scale(.6);opacity:.7} 100%{transform:scale(1.6);opacity:0} }\n.vm-stock__text{ font-size:12.5px; line-height:1.45; color:var(--vm-ink,#101012); }\n.vm-stock__text strong{ color:var(--vm-accent,#B4342A); font-weight:700; }\n\n.vm-deal{\n  display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap;\n  margin-top:12px; padding:14px 16px;\n  background:var(--vm-soft,#F6F6F7); border:1px solid var(--vm-line,#E6E7EA); border-radius:4px;\n}\n.vm-deal__label{\n  display:flex; align-items:center; gap:8px; font-size:11px; letter-spacing:.16em;\n  text-transform:uppercase; font-weight:600; color:var(--vm-muted,#6E7178);\n}\n.vm-deal__spark{\n  width:6px; height:6px; border-radius:50%; background:var(--vm-accent,#B4342A);\n  box-shadow:0 0 0 3px rgba(180,52,42,.15); animation:vmBlink 1.6s ease-in-out infinite;\n}\n@keyframes vmBlink{ 0%,100%{opacity:1} 50%{opacity:.35} }\n.vm-deal__clock{ display:flex; align-items:flex-start; gap:5px; }\n.vm-seg{\n  display:flex; flex-direction:column; align-items:center; font-weight:400;\n  background:#fff; border:1px solid var(--vm-line,#E6E7EA); border-radius:3px;\n  min-width:44px; padding:6px 8px 5px;\n}\n.vm-seg span{\n  font-size:17px; font-weight:700; line-height:1; color:var(--vm-ink,#101012);\n  font-variant-numeric:tabular-nums; font-feature-settings:\"tnum\";\n}\n.vm-seg small{ margin-top:4px; font-size:8.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--vm-muted,#6E7178); }\n.vm-colon{ font-style:normal; font-size:15px; font-weight:600; color:#B9BCC2; padding-top:8px; }\n.vm-deal.is-done{ opacity:.55; }\n\n@media (max-width:479px){ .vm-deal{ justify-content:center; } }\n@media (prefers-reduced-motion:reduce){\n  .vm-demand__fill{ animation:none; width:var(--vm-level); }\n  .vm-demand__fill::after,.vm-stock__dot::before,.vm-deal__spark{ animation:none; }\n}\n</style>\n\n<script>\n(function(){\n  function init(){\n    var box = document.getElementById('vm-countdown');\n    if(!box || box.dataset.vmReady) return;\n    box.dataset.vmReady = '1';\n\n    var KEY = 'vm_flash_deal_v1';            /* naam wijzigen = timer reset */\n    var DURATION = (15*60*1000) + (37*1000); /* 15 min 37 sec */\n\n    var h = box.querySelector('[data-vm=\"h\"]'),\n        m = box.querySelector('[data-vm=\"m\"]'),\n        s = box.querySelector('[data-vm=\"s\"]'),\n        wrap = box.closest('.vm-deal');\n\n    var end = Number(sessionStorage.getItem(KEY));\n    if(!end || isNaN(end) || end < Date.now()){\n      end = Date.now() + DURATION;\n      sessionStorage.setItem(KEY, String(end));\n    }\n    var t = setInterval(tick, 1000); tick();\n\n    function p(n){ return String(n).padStart(2,'0'); }\n    function tick(){\n      var left = Math.max(0, end - Date.now()), sec = Math.ceil(left/1000);\n      h.textContent = p(Math.floor(sec/3600));\n      m.textContent = p(Math.floor((sec%3600)/60));\n      s.textContent = p(sec%60);\n      if(left<=0){ clearInterval(t); wrap && wrap.classList.add('is-done'); }\n    }\n  }\n  document.readyState==='loading' ? document.addEventListener('DOMContentLoaded',init) : init();\n})();\n</script>",
