        "custom_liquid": "<div class=\"vm-below\">\n  <div class=\"vm-ship\">\n    <span class=\"vm-ship__rule\"></span>\n    <span class=\"vm-ship__body\">\n      <svg class=\"vm-ship__icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"\n           stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n        <path d=\"M3 7h10v9H3z\"/><path d=\"M13 10h4l3 3v3h-7z\"/>\n        <circle cx=\"7\" cy=\"17.5\" r=\"1.6\"/><circle cx=\"17\" cy=\"17.5\" r=\"1.6\"/>\n      </svg>\n      <span class=\"vm-ship__text\">Gratis verzending naar <strong>Nederland</strong></span>\n      <img class=\"vm-ship__flag\" src=\"https://flagcdn.com/24x18/nl.png\"\n           srcset=\"https://flagcdn.com/48x36/nl.png 2x\" alt=\"\" width=\"16\" height=\"12\" loading=\"lazy\">\n    </span>\n    <span class=\"vm-ship__rule\"></span>\n  </div>\n\n  <div class=\"vm-promo\">\n    <span class=\"vm-promo__pill\">Automatisch toegepast</span>\n    <p class=\"vm-promo__title\">Tot 50% korting <span>+</span> gratis armband</p>\n    <p class=\"vm-promo__sub\">Korting wordt bij het afrekenen verrekend.</p>\n  </div>\n\n  <div class=\"vm-trust\">\n    <div class=\"vm-trust__grid\">\n      <div class=\"vm-trust__item\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l7 3v5.5c0 4.6-3 8.3-7 9.5-4-1.2-7-4.9-7-9.5V6l7-3z\"/><path d=\"M9 12.2l2 2 4-4.2\"/></svg>\n        <div><p class=\"vm-trust__t\">14 dagen bedenktijd</p><p class=\"vm-trust__s\">Zonder vragen retour</p></div>\n      </div>\n      <div class=\"vm-trust__item\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12a8 8 0 0 1 13.66-5.66\"/><polyline points=\"18 3 18 7 14 7\"/><path d=\"M20 12a8 8 0 0 1-13.66 5.66\"/><polyline points=\"6 21 6 17 10 17\"/></svg>\n        <div><p class=\"vm-trust__t\">Verstelbare band</p><p class=\"vm-trust__s\">Gratis inkortset</p></div>\n      </div>\n      <div class=\"vm-trust__item\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z\"/></svg>\n        <div><p class=\"vm-trust__t\">Waterbestendig</p><p class=\"vm-trust__s\">3 ATM — regen &amp; zweet</p></div>\n      </div>\n      <div class=\"vm-trust__item\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"8\" r=\"5.5\"/><path d=\"M9 12.5L7.5 21l4.5-2.5 4.5 2.5-1.5-8.5\"/><path d=\"M9.5 8l1.7 1.7L14.5 6\"/></svg>\n        <div><p class=\"vm-trust__t\">2 jaar garantie</p><p class=\"vm-trust__s\">Volledige dekking</p></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.vm-below{ width:100%; box-sizing:border-box; font-family:inherit; }\n\n.vm-ship{ display:flex; align-items:center; gap:12px; padding:4px 0 16px; }\n.vm-ship__rule{ flex:1 1 auto; height:1px; background:var(--vm-line,#E6E7EA); }\n.vm-ship__body{ display:flex; align-items:center; gap:8px; flex:0 0 auto; }\n.vm-ship__icon{ width:16px; height:16px; color:var(--vm-ink,#101012); }\n.vm-ship__text{ font-size:11px; letter-spacing:.12em; text-transform:uppercase; font-weight:500; color:var(--vm-ink,#101012); white-space:nowrap; }\n.vm-ship__text strong{ font-weight:700; }\n.vm-ship__flag{ border-radius:2px; display:block; }\n@media (max-width:420px){ .vm-ship__rule{ display:none; } .vm-ship{ justify-content:center; } }\n\n.vm-promo{\n  background:linear-gradient(180deg,#FAFAFA 0%,#F3F3F4 100%);\n  border:1px solid var(--vm-line,#E6E7EA); border-radius:4px;\n  padding:24px 22px 22px; text-align:center;\n}\n.vm-promo__pill{\n  display:inline-block; margin-bottom:12px; padding:5px 11px;\n  font-size:9.5px; letter-spacing:.2em; text-transform:uppercase; font-weight:600;\n  color:#8A6D34; background:#FBF5E9; border:1px solid #EADFC6; border-radius:99px;\n}\n.vm-promo__title{ margin:0 0 7px; font-size:16px; line-height:1.3; font-weight:700; text-transform:uppercase; color:var(--vm-ink,#101012); }\n.vm-promo__title span{ color:var(--vm-gold,#C2A268); font-weight:400; }\n.vm-promo__sub{ margin:0; font-size:12.5px; line-height:1.45; color:var(--vm-muted,#6E7178); }\n\n.vm-trust{\n  margin-top:20px; padding:4px 0;\n  border-top:1px solid var(--vm-line,#E6E7EA); border-bottom:1px solid var(--vm-line,#E6E7EA);\n}\n.vm-trust__grid{ display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--vm-line,#E6E7EA); }\n.vm-trust__item{ display:flex; align-items:flex-start; gap:11px; background:var(--vm-page,#fff); padding:18px 16px; }\n.vm-trust__item svg{ flex:0 0 auto; width:19px; height:19px; margin-top:1px; color:var(--vm-ink,#101012); }\n.vm-trust__t{ margin:0 0 3px; font-size:13px; font-weight:700; line-height:1.3; color:var(--vm-ink,#101012); }\n.vm-trust__s{ margin:0; font-size:12px; line-height:1.4; color:var(--vm-muted,#6E7178); }\n@media (max-width:479px){\n  .vm-trust__item{ padding:15px 12px; gap:9px; }\n  .vm-trust__t{ font-size:12px; } .vm-trust__s{ font-size:11px; }\n}\n</style>",
