      "name": "block 3",
      "settings": {
        "custom_liquid": "<style>\n:root{\n  --vm-ink:    #101012;\n  --vm-muted:  #6E7178;\n  --vm-line:   #E6E7EA;\n  --vm-soft:   #F6F6F7;\n  --vm-page:   #FFFFFF;\n  --vm-accent: #B4342A;\n  --vm-gold:   #C2A268;\n}\n\n/* ---- TITEL ---- */\n.product-details h1{\n  font-size:clamp(21px,2.3vw,28px) !important;\n  font-weight:700 !important;\n  letter-spacing:.06em !important;\n  text-transform:uppercase;\n  line-height:1.2 !important;\n  color:var(--vm-ink) !important;\n}\n\n/* ---- PRIJS ---- */\n.product-details product-price .price__sale,\n.product-details product-price .price__regular{\n  display:flex !important; align-items:baseline; flex-wrap:wrap; gap:10px;\n}\n.product-details product-price .price{\n  font-size:20px !important; font-weight:700 !important;\n  color:var(--vm-ink) !important; letter-spacing:.01em;\n}\n.product-details product-price .compare-at-price{\n  font-size:14px !important; font-weight:400 !important;\n  color:var(--vm-muted) !important; text-decoration:line-through;\n  text-decoration-thickness:1px;\n}\n.product-details .vm-off{\n  display:inline-flex; align-items:center;\n  background:var(--vm-ink); color:#fff;\n  font-size:11px; font-weight:700; letter-spacing:.1em;\n  padding:5px 9px; border-radius:2px; line-height:1;\n  font-variant-numeric:tabular-nums;\n}\n\n/* ---- VARIANT-KIEZER ---- */\n.product-details .variant-picker legend{\n  font-size:10.5px !important; letter-spacing:.18em; text-transform:uppercase;\n  font-weight:600; color:var(--vm-muted) !important; margin-bottom:10px;\n}\n.product-details .variant-option__button-label__pill:empty{ display:none !important; }\n.product-details .variant-option__button-label{\n  border:1px solid var(--vm-line) !important;\n  border-radius:2px !important;\n  padding:11px 14px !important;\n  background:var(--vm-page) !important;\n  transition:border-color .2s ease, box-shadow .2s ease, background .2s ease;\n}\n.product-details .variant-option__button-label:hover{ border-color:#B9BCC2 !important; }\n.product-details .variant-option__button-label:has(input:checked){\n  border-color:var(--vm-ink) !important;\n  box-shadow:inset 0 0 0 1px var(--vm-ink);\n}\n.product-details .variant-option__button-label__text{\n  font-size:11px !important; letter-spacing:.14em; text-transform:uppercase; font-weight:500;\n  color:var(--vm-ink) !important;\n}\n\n/* ---- AANTAL + KNOP ---- */\n.product-details .quantity-selector{\n  border:1px solid var(--vm-line) !important; border-radius:2px !important;\n}\n.product-details .add-to-cart-button{\n  width:100% !important;\n  min-height:56px !important;\n  border-radius:2px !important;\n  background:var(--vm-ink) !important;\n  color:#fff !important;\n  border:1px solid var(--vm-ink) !important;\n  font-size:12px !important; font-weight:700 !important;\n  letter-spacing:.2em !important; text-transform:uppercase;\n  transition:background .25s ease, transform .15s ease;\n}\n.product-details .add-to-cart-button:hover{ background:#2A2A2E !important; }\n.product-details .add-to-cart-button:active{ transform:translateY(1px); }\n/* winkelwagen-icoon in de knop verbergen — regel weghalen om te tonen */\n.product-details .add-to-cart-button .add-to-cart-icon{ display:none !important; }\n\n/* ---- DIVIDER ---- */\n.product-details .divider__line{ border-color:var(--vm-line) !important; }\n</style>\n\n<script>\n(function(){\n  var ROOT = '.product-details product-price';\n\n  function num(txt){\n    if(!txt) return NaN;\n    var s = txt.replace(/[^\\d.,]/g,'').trim();\n    if(!s) return NaN;\n    var c = s.lastIndexOf(','), d = s.lastIndexOf('.');\n    s = (c > d) ? s.replace(/\\./g,'').replace(',','.') : s.replace(/,/g,'');\n    return parseFloat(s);\n  }\n\n  function render(el){\n    var badge = el.querySelector('.vm-off');\n    if(badge) badge.remove();\n\n    var comp = el.querySelector('.compare-at-price');\n    var sale = el.querySelector('.price-item--sale') || el.querySelector('.price');\n    if(!comp || !sale) return;\n\n    var now = num(sale.textContent), was = num(comp.textContent);\n    if(!isFinite(now) || !isFinite(was) || was <= now) return;\n\n    var pct = Math.round((1 - now/was) * 100);\n    if(pct < 1) return;\n\n    var span = document.createElement('span');\n    span.className = 'vm-off';\n    span.textContent = '\\u2212' + pct + '%';\n    (el.querySelector('.price__sale') || el.querySelector('.price__container') || el).appendChild(span);\n  }\n\n  function watch(el){\n    if(el.dataset.vmOff) return;\n    el.dataset.vmOff = '1';\n    var obs = new MutationObserver(function(){\n      obs.disconnect();\n      render(el);\n      obs.observe(el, {childList:true, subtree:true, characterData:true});\n    });\n    render(el);\n    obs.observe(el, {childList:true, subtree:true, characterData:true});\n  }\n\n  function init(){ document.querySelectorAll(ROOT).forEach(watch); }\n  document.readyState==='loading' ? document.addEventListener('DOMContentLoaded',init) : init();\n  document.addEventListener('variant:update', init);\n})();\n</script>",
        "color_scheme": "",
